# Copy to .env (or ~/.config/rusty/.env) and fill in. Never commit the real file.
NVIDIA_API_KEY=nvapi-...
# Optional extra keys; rusty rotates to the next one on 429 / 5xx / auth errors.
NVIDIA_API_KEY_2=
# Optional overrides
# RUSTY_MODEL=nvidia/nemotron-3-super-120b-a12b
# RUSTY_BASE_URL=https://integrate.api.nvidia.com/v1
