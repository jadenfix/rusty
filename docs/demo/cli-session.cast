[14.387, "o", "     \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m 1\u25cf 2\u00d7 3\u25cf \u00b7 read-only                                               \u001b[0m\r\r\n\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u2808\u283b\u28ff\u28ff\u28ff\u2877\u286a\u281e\u2801\u001b[0m\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m Esc/Ctrl-C stop \u00b7 Enter steer \u00b7 Tab hint                           \u001b[0m\r\r\n\u001b[38;2;126;122;117m          \u001b[0m\u001b[38;2;226;220;211m\u2810\u2812\u001b[0m\u001b[38;2;126;122;117m       \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[38;2;218;143;115m\u203a\u001b[0m \u001b[38;2;126;122;117m\u001b[0m\r\u001b[2C\u001b[?25h"]
