[15.392, "o", "\r\u001b[8A\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[8A\u001b[?25h\u001b[?25l\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[38;2;126;122;117m        \u001b[0m\u001b[38;2;226;220;211m\u2820\u28a0\u28e4\u28e4\u28e4\u001b[0m\u001b[38;2;126;122;117m      \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n      \u001b[38;2;226;220;211m\u28c0\u28e0\u28e4\u28fe\u287f\u28bb\u289f\u001b[0m      \u001b[38;2;226;220;211m\u2502\u001b[0m \u001b[1m\u001b[38;2;218;143;115mrusty\u001b[0m\u001b[0m / swarm                                             vibe \u00b7 4s\r\r\n     \u001b[38;2;226;220;211m\u28f4\u287f\u281b\u28ff\u28ff\u28bf\u28f7\u28ff\u28e6\u2844\u001b[0m    \u001b[38;2;226;220;211m\u2502\u001b[0m 2/3 returned \u00b7 1 running \u00b7 1 failed \u00b7 3 calls                      \r\r\n\u001b[38;2;126;122;117m    \u001b[0m\u001b[38;2;226;220;211m\u2830\u28ff"]
