[7.135, "o", "\r\u001b[8A\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[8A\u001b[?25h\u001b[?25l\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[38;2;126;122;117m       \u001b[0m\u001b[38;2;218;143;115m\u28c0\u28c0\u28c0\u2840\u001b[0m\u001b[38;2;126;122;117m        \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n     \u001b[38;2;218;143;115m\u2880\u28fe\u287f\u281f\u283b\u28ff\u28e6\u28e4\u28f6\u28e4\u001b[0m    \u001b[38;2;226;220;211m\u2502\u001b[0m \u001b[1m\u001b[38;2;218;143;115mrusty\u001b[0m\u001b[0m / thinking                                      standard \u00b7 0s\r\r\n     \u001b[38;2;218;143;115m\u28ff\u28ff\u28e4\u28e4\u28f6\u28ff\u28ff\u28ff\u289f\u285f\u001b[0m    \u001b[38;2;226;220;211m\u2502\u001b[0m Tinkering                                                          \r\r\n\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;218;143;115m\u28bf"]
