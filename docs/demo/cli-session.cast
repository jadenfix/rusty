[13.839, "o", "\r\u001b[8A\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[8A\u001b[?25h\u001b[?25l\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[38;2;126;122;117m       \u001b[0m\u001b[38;2;226;220;211m\u2880\u28e0\u28e4\u28c0\u2804\u2824\u001b[0m\u001b[38;2;126;122;117m      \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n      \u001b[38;2;226;220;211m\u28f0\u28ff\u285f\u281b\u28ff\u28c7\u28e0\u28e4\u28c4\u001b[0m    \u001b[38;2;226;220;211m\u2502\u001b[0m \u001b[1m\u001b[38;2;218;143;115mrusty\u001b[0m\u001b[0m / swarm                                             vibe \u00b7 2s\r\r\n     \u001b[38;2;226;220;211m\u2880\u28ff\u28ff\u28f6\u28f6\u28fe\u28ff\u28ff\u289f\u281f\u001b[0m    \u001b[38;2;226;220;211m\u2502\u001b[0m 1/3 returned \u00b7 2 running \u00b7 1 failed \u00b7 3 calls                      \r\r\n\u001b[38;2;126;122;117m   \u001b[0m\u001b[38;2;226;220;211m"]
[13.839, "o", "\u2830\u2840\u001b[0m\u001b[38;2;126;122;117m \u001b[0m\u001b[38;2;226;220;211m\u28ff\u28ff\u28c1\u28f4\u286a\u28bf\u2877\u2801\u001b[0m\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m 1\u25cf 2\u00d7 3\u25cf \u00b7 read-only                                               \u001b[0m\r\r\n\u001b[38;2;126;122;117m      \u001b[0m\u001b[38;2;226;220;211m\u2818\u283f\u28ff\u289f\u2874\u28ea\u281e\u001b[0m\u001b[38;2;126;122;117m \u001b[0m\u001b[38;2;226;220;211m\u28c0\u2804\u001b[0m\u001b[38;2;126;122;117m   \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m Esc/Ctrl-C stop \u00b7 Enter steer \u00b7 Tab hint                           \u001b[0m\r\r\n\u001b[38;2;126;122;117m         \u001b[0m\u001b[38;2;226;220;211m\u2809\u2808\u001b[0m\u001b[38;2;126;122;117m        \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0"]
