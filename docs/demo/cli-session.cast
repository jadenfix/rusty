[11.417, "o", ";115m\u28bb\u28ff\u28ef\u28c1\u28fd\u286b\u283f\u28ff\u2849\u001b[0m\u001b[0m\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n\u001b[38;2;126;122;117m      \u001b[0m\u001b[1m\u001b[38;2;218;143;115m\u2819\u283b\u28ff\u289f\u2865\u28ea\u281f\u2801\u001b[0m\u001b[0m\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m Esc/Ctrl-C stop \u00b7 Enter steer \u00b7 Tab hint                           \u001b[0m\r\r\n\u001b[38;2;126;122;117m         \u001b[0m\u001b[1m\u001b[38;2;218;143;115m\u2808\u2808\u001b[0m\u001b[0m\u001b[38;2;126;122;117m        \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[38;2;218;143;115m\u203a\u001b[0m \u001b[38;2;126;122;117m\u001b[0m\r\u001b[2C\u001b[?25h"]
