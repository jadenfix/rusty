[13.563, "o", "\u28ff\u28e6\u28f4\u28ea\u28be\u2855\u280b\u001b[0m\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2840\u001b[0m\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m 1\u25cf 2\u00d7 3\u25cf \u00b7 read-only                                               \u001b[0m\r\r\n\u001b[38;2;126;122;117m    \u001b[0m\u001b[38;2;226;220;211m\u2811\u2804\u281b\u287d\u28fb\u288f\u2874\u28eb\u2806\u001b[0m\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2818\u001b[0m\u001b[38;2;126;122;117m   \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m Esc/Ctrl-C stop \u00b7 Enter steer \u00b7 Tab hint                           \u001b[0m\r\r\n\u001b[38;2;126;122;117m       \u001b[0m\u001b[38;2;226;220;211m\u2808\u2801\u2809\u2808\u001b[0m\u001b[38;2;126;122;117m        \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0"]
