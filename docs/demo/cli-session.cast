[13.903, "o", "\u2838\u001b[0m\u001b[38;2;126;122;117m \u001b[0m\u001b[38;2;226;220;211m\u2808\u28ff\u28ef\u28c1\u28fd\u286b\u289f\u2877\u2801\u001b[0m\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m 1\u25cf 2\u00d7 3\u25cf \u00b7 read-only                                               \u001b[0m\r\r\n\u001b[38;2;126;122;117m      \u001b[0m\u001b[38;2;226;220;211m\u2818\u283f\u28ff\u289f\u2865\u28ea\u281e\u001b[0m\u001b[38;2;126;122;117m \u001b[0m\u001b[38;2;226;220;211m\u28c0\u001b[0m\u001b[38;2;126;122;117m    \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m Esc/Ctrl-C stop \u00b7 Enter steer \u00b7 Tab hint                           \u001b[0m\r\r\n\u001b[38;2;126;122;117m         \u001b[0m\u001b[38;2;226;220;211m\u2809\u2808\u001b[0m\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2808\u001b[0m\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
