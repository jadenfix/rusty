[9.07, "o", "\r\u001b[8A\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[8A\u001b[?25h\u001b[?25l\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[38;2;126;122;117m         \u001b[0m\u001b[38;2;226;220;211m\u28e0\u28f4\u28e6\u2844\u001b[0m\u001b[38;2;126;122;117m      \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n       \u001b[38;2;226;220;211m\u28c0\u28fe\u28ff\u280b\u28f9\u281f\u001b[0m      \u001b[38;2;226;220;211m\u2502\u001b[0m \u001b[1m\u001b[38;2;218;143;115mrusty\u001b[0m\u001b[0m / subagent                                      standard \u00b7 1s\r\r\n     \u001b[38;2;226;220;211m\u28f0\u28ff\u28ff\u28ff\u283f\u28ff\u28f7\u28f7\u28f6\u28e6\u001b[0m    \u001b[38;2;226;220;211m\u2502\u001b[0m 0/1 returned \u00b7 1 running \u00b7 0 failed \u00b7 1 calls                      \r\r\n\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u28ff\u28cf\u2838"]
[9.07, "o", "\u28ff\u2876\u28e8\u289e\u2874\u286b\u280b\u001b[0m\u001b[38;2;126;122;117m    \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m 1\u25cf \u00b7 read-only                                                     \u001b[0m\r\r\n\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u2819\u28ff\u28e6\u28e0\u288c\u2875\u284b\u001b[0m\u001b[38;2;126;122;117m       \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m Esc/Ctrl-C stop \u00b7 Enter steer \u00b7 Tab hint                           \u001b[0m\r\r\n\u001b[38;2;126;122;117m       \u001b[0m\u001b[38;2;226;220;211m\u2819\u280b\u2809\u001b[0m\u001b[38;2;126;122;117m         \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[38;2;218;143;115m\u203a\u001b[0m \u001b[38;2;126;122;117m\u001b[0m\r\u001b[2C\u001b[?25h"]
[9.141, "o", "\r\u001b[8A\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[1B\r\u001b[2K\u001b[8A\u001b[?25h\u001b[?25l\u001b[38;2;126;122;117m  \u001b[0m\u001b[38;2;226;220;211m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[38;2;126;122;117m        \u001b[0m\u001b[38;2;226;220;211m\u2880\u28e0\u28f4\u28e4\u2840\u001b[0m\u001b[38;2;126;122;117m      \u001b[0m\u001b[38;2;226;220;211m\u2502\u001b[0m\u001b[38;2;126;122;117m                                                                    \u001b[0m\r\r\n       \u001b[38;2;226;220;211m\u2880\u28fe\u287f\u280b\u28fb\u2807\u001b[0m      \u001b[38;2;226;220;211m\u2502\u001b[0m \u001b[1m\u001b[38;2;218;143;115mrusty\u001b[0m\u001b[0m / subagent                                      standard \u00b7 1s\r\r\n     \u001b[38;2;226;220;211m\u28a0\u28fe\u28ff\u28ff\u283f\u28ff\u28f7\u28f7\u28f6\u28e6\u001b[0m    \u001b[38;2;226;220;211m\u2502\u001b[0m 0/1 returned \u00b7 1 running \u00b7 0 failed \u00b7 1 calls                      \r\r\n\u001b[38;2;126;122;117m     \u001b[0m\u001b[38;2;226;220;211m\u28ff\u28cf"]
