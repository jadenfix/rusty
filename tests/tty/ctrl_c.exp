# Drives the interactive REPL in a real pseudo-terminal:
#   1. Ctrl-C during a streaming turn stops it quickly
#   2. the next turn still works
#   3. Ctrl-C twice at an empty prompt quits
# Usage: expect tests/tty/ctrl_c.exp /path/to/rusty
set timeout 90
set bin [lindex $argv 0]
spawn -noecho $bin --yolo
proc ready {} { expect -re {\?2004h}; sleep 0.4 }
ready
send -- "count from one to three thousand in words, one per line, no tools\r"
expect -re {[A-Z][a-z]+(ing)?[^\n]*…}
sleep 3
set t0 [clock milliseconds]
send "\x03"
expect {
  -re {stopped} { set ms [expr {[clock milliseconds] - $t0}] }
  timeout { puts "\nFAIL: ctrl-c did not stop the turn"; exit 1 }
}
if {$ms > 2000} { puts "\nFAIL: took ${ms}ms to stop"; exit 1 }
ready
send -- "reply with just the word pong\r"
expect {
  -re {pong\s} {}
  timeout { puts "\nFAIL: turn after interrupt did not work"; exit 1 }
}
ready
send "\x03"
expect -re {again to quit}
send "\x03"
expect eof
puts "\nPASS: stopped in ${ms}ms, recovered, quit on double ctrl-c"
