# Real PTY capture with a deterministic provider, no credentials required.
# expect tests/tty/steady.exp binary endpoint width capture-dir
set timeout 30
set bin [lindex $argv 0]
set env(RUSTY_BASE_URL) [lindex $argv 1]
set cols [lindex $argv 2]
set dest [lindex $argv 3]
set env(NVIDIA_API_KEY) offline-test-key
set env(RUSTY_NO_DOTENV) 1
set env(RUSTY_HOME) "$dest/home"
set env(TERM) xterm-256color
unset -nocomplain env(NO_COLOR)
log_user 0
log_file -a -noappend "$dest/terminal-$cols.ansi"
spawn -noecho $bin --yolo --mode standard --agents off --memory off --trajectory "$dest/trajectory-$cols.json" capture
stty rows 24 columns $cols < $spawn_out(slave,name)
expect {
    -ex "CAPTURE_COMPLETE" {}
    timeout { puts "FAIL: capture timed out"; exit 1 }
}
expect eof
set result [wait]
if {[lindex $result 3] != 0} { puts "FAIL: rusty exited $result"; exit 1 }
puts "PASS: captured real PTY at $cols columns"
